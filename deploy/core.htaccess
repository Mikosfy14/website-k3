# Upload file ini sebagai ".htaccess" di dalam folder htdocs/core/
# (sejajar dengan app/, vendor/, bootstrap/, dst. - bukan di htdocs/ itu sendiri).
#
# Tujuannya: blokir akses HTTP langsung ke semua file di dalam core/,
# termasuk .env yang kalau diakses langsung akan ter-serve sebagai teks
# polos (bukan dieksekusi) dan membocorkan password database.
#
# Mendukung Apache 2.4+ (mod_authz_core) dan fallback ke syntax lama.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
